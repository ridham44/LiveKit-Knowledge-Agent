# Backend Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/knowledgevoice

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRE=7d

# LLM (via OpenRouter - https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini

# Embeddings run locally in-process (Xenova/all-MiniLM-L6-v2 via @huggingface/transformers)
# No API key required for embeddings.

# File Upload
MAX_FILE_SIZE=52428800

# Optional, local development only - defaults to ./uploads if unset. Uploaded files are
# only staged here for the few seconds it takes to extract their text into MongoDB (the
# actual persistent store), then deleted, so production doesn't need this set to anything
# in particular - no persistent volume/disk required.
UPLOAD_DIR=./uploads

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-secret

# Text-to-speech for the Voice page. The browser posts the assistant's answer here to
# be spoken, so the key stays server-side instead of being exposed to the client.
# Get one at https://console.deepgram.com/signup (free tier is fine).
DEEPGRAM_API_KEY=your-deepgram-key

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Shared secret for the voice-agent process to call internal APIs (not a user JWT).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match the same value in voice-agent/.env
AGENT_SHARED_SECRET=your-random-shared-secret

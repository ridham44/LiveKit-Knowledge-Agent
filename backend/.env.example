# Backend Configuration
# PORT is only used when running this as a traditional long-lived process (local dev,
# or any non-Vercel host). Vercel serverless functions never read it - the platform
# handles the port itself.
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/knowledgevoice

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRE=7d

# LLM + embeddings (both via OpenRouter - https://openrouter.ai/keys - one key, one
# bill). Embeddings previously ran locally in-process (Xenova/all-MiniLM-L6-v2 via
# @huggingface/transformers). That doesn't run reliably as a Vercel serverless
# function - see backend/src/services/ai/embeddingService.js for why - so this is now
# a remote API call to OpenRouter's OpenAI-compatible /embeddings endpoint instead,
# reusing the same OPENROUTER_API_KEY already required for chat. File upload / RAG
# will fail without this key.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small

# File Upload
# Vercel Functions hard-cap the total request body at 4.5MB regardless of this value -
# keep this at or below ~4MB so the app's own "file too large" error fires instead of
# a generic platform-level 413. See backend/src/routes/files.js.
MAX_FILE_SIZE=4194304

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-secret

# Text-to-speech for the Voice page. The browser posts the assistant's answer here to
# be spoken, so the key stays server-side instead of being exposed to the client.
# Get one at https://console.deepgram.com/signup (free tier is fine).
DEEPGRAM_API_KEY=your-deepgram-key

# CORS / this app's own public URL.
# Not needed on Vercel: the frontend and API are same-origin there, and this app
# auto-trusts its own deployment via Vercel's VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL
# env vars (see backend/src/config/cors.js and publicUrl.js) - no config required.
# Only set these if you attach a custom domain, or need local dev to hit a port other
# than Vite's default 5173.
# APP_URL=https://your-custom-domain.com
# FRONTEND_DEV_URL=http://localhost:5173
# CORS_ORIGINS=https://your-custom-domain.com,https://another-domain.com

# Shared secret for the voice-agent process to call internal APIs (not a user JWT).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match the same value in voice-agent/.env
AGENT_SHARED_SECRET=your-random-shared-secret

# Brevo - sends the signup email-verification OTP via Brevo's transactional email
# HTTP API (backend/src/services/emailService.js), POST https://api.brevo.com/v3/smtp/email.
# Signup fails at the "send code" step without these. Get an API key (not an SMTP
# key) at https://app.brevo.com/settings/keys/api.
BREVO_API_KEY=xkeysib-your-api-key-here
# Must be a sender Brevo has verified for this account (Senders, Domains & Dedicated
# IPs) - either a single verified sender address, or any address on a domain you've
# authenticated there. An unverified sender is accepted by the API call (still
# returns success) but silently fails to actually send - see BREVO_FROM_EMAIL's
# delivery status in Brevo's Transactional > Logs if emails aren't arriving.
BREVO_FROM_EMAIL=no-reply@your-domain.com
BREVO_FROM_NAME=Work24
